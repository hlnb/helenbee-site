{# Shared masthead: paper and separate imagery keep text readable on every image. #}
<section class="brand-hero{% if hero_article %} brand-hero--article{% elif image %} brand-hero--split{% endif %}">
  <div class="brand-hero__copy">
    <p class="eyebrow">{% if hero_article %}{{ writingCategories[category] or category or 'From the digital garden' }}{% else %}Receive · Read · Carry forward{% endif %}</p>
    {% if not hero_hide_title %}<h1>{{ title or page.title }}</h1>{% endif %}
    {% if subtitle or (hero_article and description) %}
      <p class="lead">{{ subtitle or description }}</p>
    {% endif %}
    {% if hero_extra %}<div class="hero-extra">{{ hero_extra | safe }}</div>{% endif %}
    {% if not hero_hide_date %}
      <div class="writing-meta">
        {% if date or page.date %}<time datetime="{{ (date or page.date) | htmlDateString }}">{{ (date or page.date) | readableDate }}</time>{% endif %}
        {% if category %}<span class="tag">{{ writingCategories[category] or category }}</span>{% endif %}
        {% for tag in tags %}{% if tag != 'post' %}<span class="tag">#{{ tag }}</span>{% endif %}{% endfor %}
      </div>
    {% endif %}
  </div>
  {% if image %}
    <figure class="brand-hero__figure">
      <img class="brand-hero-image" src="{{ image }}" alt="{{ image_alt or ('Cover of ' + title if coverImage else '') }}" fetchpriority="high">
    {# Provider-neutral image attribution. Legacy Unsplash fields remain supported. #}
    {% if image and image_credit and (image_credit.photographer or image_credit.username or image_credit.copyright_notice or image_credit.source_name or image_credit.photo_url) %}
      {% set creditName = image_credit.photographer or image_credit.username %}
      {% set creditUrl = image_credit.profile_url %}
      {% set sourceName = image_credit.source_name %}
      {% if not creditUrl and image_credit.username %}
        {% set creditUrl = "https://unsplash.com/" + image_credit.username | replace("@", "") + "?utm_source=helenburgess&utm_medium=referral" %}
      {% endif %}
      {% if not sourceName and ((image_credit.photo_url and "unsplash.com" in image_credit.photo_url) or image_credit.username) %}
        {% set sourceName = "Unsplash" %}
      {% endif %}
      <div class="image-credit">
        Image credit:
        {% if creditName %}
          {% if creditUrl %}
            <a href="{{ creditUrl }}" target="_blank" rel="noopener noreferrer">{{ creditName }}</a>
          {% else %}
            {{ creditName }}
          {% endif %}
        {% endif %}
        {% if image_credit.copyright_notice %}
          {% if creditName %}<span aria-hidden="true"> · </span>{% endif %}{{ image_credit.copyright_notice }}
        {% endif %}
        {% if sourceName %}
          {% if creditName or image_credit.copyright_notice %}<span aria-hidden="true"> · </span>{% endif %}Source:
          {% if image_credit.photo_url %}
            <a href="{{ image_credit.photo_url }}" target="_blank" rel="noopener noreferrer">{{ sourceName }}</a>
          {% else %}
            {{ sourceName }}
          {% endif %}
        {% elif image_credit.photo_url %}
          {% if creditName or image_credit.copyright_notice %}<span aria-hidden="true"> · </span>{% endif %}<a href="{{ image_credit.photo_url }}" target="_blank" rel="noopener noreferrer">View image source</a>
        {% endif %}
      </div>
    {% endif %}
    </figure>
  {% endif %}
</section>
