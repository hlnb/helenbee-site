<a class="skip-link" href="#main-content">Skip to content</a>
<div class="utility-bar"><span>RAAF veteran · writer · maker</span><span>Perth, Western Australia</span></div>
<header class="site-header">
  <nav class="navbar" aria-label="Main navigation">
    <div class="navbar-brand">
      <a href="/" class="brand" aria-label="Helen B home">
        <span class="signoff">Helen B</span>
        {% set tape_compact = true %}
        {% include "partials/brand-tape.njk" %}
      </a>
      <button type="button" class="navbar-burger" aria-label="Menu" aria-expanded="false" aria-controls="navbarMenu">
        <span>Menu</span><span aria-hidden="true">☰</span>
      </button>
    </div>
    <div id="navbarMenu" class="navbar-menu">
      <ul class="navbar-end">
        {% set navPages = collections.all | eleventyNavigation %}
        {% for entry in navPages %}
          <li><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.key }}</a></li>
        {% endfor %}
        <li><a href="/life-after-service/"{% if page.url == '/life-after-service/' %} aria-current="page"{% endif %}>Life after service</a></li>
        <li><a href="https://graphitedge.com.au" target="_blank" rel="noopener noreferrer">Graphitedge</a></li>
      </ul>
    </div>
  </nav>
</header>
