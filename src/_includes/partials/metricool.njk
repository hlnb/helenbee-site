{# Respect the analytics choice offered by the site's cookie notice. #}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    let metricoolLoaded = false;

    function loadMetricool() {
      if (metricoolLoaded) return;
      metricoolLoaded = true;

      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.src = 'https://tracker.metricool.com/resources/be.js';
      script.onload = function () {
        beTracker.t({ hash: '6b34a182c4018ce46b6adf68b6255098' });
      };
      document.head.appendChild(script);
    }

    try {
      if (localStorage.getItem('cookieConsent') === 'accepted') loadMetricool();
    } catch (error) {
      // If storage is unavailable, wait for an explicit acceptance below.
    }

    const acceptButton = document.getElementById('accept-cookies');
    if (acceptButton) acceptButton.addEventListener('click', loadMetricool);
  });
</script>
