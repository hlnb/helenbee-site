<section class="hb-home-hero" aria-labelledby="home-heading">
  <div>
    <p class="eyebrow">Receive · Read · Carry forward</p>
    <h1 id="home-heading">Stories received.<br>Meaning carried forward.</h1>
    <p class="lead">{{ subtitle }}</p>
    {{ hero_extra | safe }}
    <a class="text-link" href="/about/">Meet Helen <span aria-hidden="true">→</span></a>
  </div>
  <div class="tape-reader" aria-label="Abstract reader inspired by the Model 40/8 transmission head">
    <div class="reader-label"><span>MODEL 40/8</span><span>MESSAGE PATH</span></div>
    <div class="reader-slot"></div>
    <div class="reader-tape">
      {% set tape_compact = false %}
      {% include "partials/brand-tape.njk" %}
    </div>
    <div class="reader-status"><span class="status-light" aria-hidden="true"></span>FEED TRACK CLEAR</div>
  </div>
</section>
